{
  "name": "@ingestron/provider-databricks",
  "version": "3.15.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs && python3 -m unittest discover -s test -p \"test_*.py\"",
    "validate": "pnpm format:check && pnpm build && pnpm test && pnpm docs:check && pnpm secrets:check",
    "secrets:check": "node scripts/secrets.mjs",
    "sdk:check": "python3 -m unittest discover -s test -p sdk_contract.py",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/docs-check.mjs",
    "acceptance": "node scripts/acceptance.mjs"
  },
  "devDependencies": {
    "@lezer/python": "1.1.19",
    "antlr4ng": "2.0.11",
    "dt-sql-parser": "4.5.1",
    "esbuild": "0.28.2",
    "nunjucks": "3.2.4",
    "prettier": "3.9.6",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingestron/provider-databricks.git"
  }
}
